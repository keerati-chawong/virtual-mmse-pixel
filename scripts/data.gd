# ------------------------------------------------------------
# helpers
# ------------------------------------------------------------
func part_of(id: String) -> Dictionary:
	for p in PARTS:
		if p.id == id:
			return p
	return {}

func kit_item(k: String) -> Dictionary:
	for x in KIT:
		if x.k == k:
			return x
	return {}

func kit_name(k: String) -> String:
	return kit_item(k).get("t", k)

func cut_of(k: String) -> Dictionary:
	for c in MMSE_CUT:
		if c.k == k:
			return c
	return MMSE_CUT[2]

func scenario(k: String) -> Dictionary:
	for s in SCENARIOS:
		if s.k == k:
			return s
	return SCENARIOS[0]

## แทนตัวแปรในข้อความตามสถานการณ์ปัจจุบัน
func t(s: String) -> String:
	var sc: Dictionary = G.scn()
	var first: String = sc.name.replace("คุณยาย", "").replace("คุณ", "")
	return s.replace("{c}", sc.c).replace("{k}", sc.k_).replace("{me}", sc.me) \
		.replace("{name}", sc.name).replace("{ward}", sc.ward).replace("{first}", first)
